{
  "name": "soluciona-inteligencia-artificial-comercial",
  "version": "1.0.0",
  "private": true,
  "description": "Soluciona IA - Sistema de pedidos por WhatsApp + paneles (comercial)",
  "license": "MIT",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "reset-admin": "node reset-admin.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:migrate-data": "node --experimental-sqlite src/db/migrate-sqlite-to-pg.js",
    "db:verify-pg": "node --experimental-sqlite src/db/verify-pg.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@whiskeysockets/baileys": "^6.7.24",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.11.4",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.31.2",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.3",
    "node-forge": "^1.4.0",
    "pg": "^8.11.5",
    "pino": "^9.0.0",
    "postgres": "^3.4.4",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "werift": "^0.24.4",
    "xmldom": "^0.6.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.0",
    "drizzle-kit": "^0.22.8",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "tsx": "^4.23.12",
    "typescript": "^5.4.5",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

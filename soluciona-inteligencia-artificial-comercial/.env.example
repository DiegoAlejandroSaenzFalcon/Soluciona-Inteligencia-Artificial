# Soluciona IA - Environment Configuration Example
# Copy this file to .env and fill in your values
# NEVER commit the real .env file - it's in .gitignore

# ============================================================
# CORE APPLICATION
# ============================================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soluciona_ia
DB_USER=postgres
DB_PASS=CHANGE_ME_USE_STRONG_PASSWORD
DB_POOL_SIZE=10
DB_DEBUG=false
DB_ENGINE=sqlite

# ============================================================
# REDIS
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
# MINIO (S3-compatible storage)
# ============================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_USE_STRONG_PASSWORD
MINIO_BUCKET=soluciona
MINIO_REGION=us-east-1
MINIO_SECURE=false

# ============================================================
# JWT AUTHENTICATION
# ============================================================
# IMPORTANT: Generate a strong secret (min 32 chars)
# Use: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ISSUER=soluciona-inteligencia-artificial-comercial
JWT_AUDIENCE=dashboard
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ROTATION_DAYS=30

# ============================================================
# LLM PROVIDERS (NVIDIA, OpenAI, Anthropic, Google, Local)
# ============================================================
# Chatbot WhatsApp (Key 1)
LLM_PROVEEDOR=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-8b-instruct
LLM_API_KEY=your-nvidia-api-key-here
LLM_LIMITE_DIARIO=200
LLM_LIMITE_MENSUAL=5000

# Asistentes IA Panel (Key 2)
ASISTENTES_IA_PROVEEDOR=nvidia
ASISTENTES_IA_BASE_URL=https://integrate.api.nvidia.com/v1
ASISTENTES_IA_MODEL=meta/llama-3.3-70b-instruct
ASISTENTES_IA_API_KEY=your-nvidia-api-key-here
ASISTENTES_IA_LIMITE_DIARIO=50
ASISTENTES_IA_LIMITE_MENSUAL=1000

# Vision (Foto menú) (Key 3)
VISION_PROVEEDOR=nvidia
VISION_BASE_URL=https://integrate.api.nvidia.com/v1
VISION_MODEL=meta/llama-3.2-11b-vision-instruct
VISION_API_KEY=your-nvidia-api-key-here
VISION_LIMITE_DIARIO=30
VISION_LIMITE_MENSUAL=500

# Fallback
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ============================================================
# WHATSAPP BUSINESS
# ============================================================
WHATSAPP_AUTH_DIR=./auth_info
WHATSAPP_QR_REFRESH_INTERVAL=30000
WHATSAPP_RECONNECT_BASE_DELAY=5000
WHATSAPP_RECONNECT_MAX_DELAY=300000
WHATSAPP_RECONNECT_JITTER=0.2

# ============================================================
# INTEGRATIONS (POS/ERP/Accounting)
# ============================================================
# Siigo
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=
SIIGO_DOCUMENT_ID=22
SIIGO_PAYMENT_ID=5636
SIIGO_TAX_ID=13156
SIIGO_CUSTOMER_IDENTIFICATION=
SIIGO_STAMP_DIAN=false

# Alegra
ALEGRA_EMAIL=
ALEGRA_TOKEN=
ALEGRA_ID_TYPE=CC
ALEGRA_CUSTOMER_IDENTIFICATION=
ALEGRA_TAX_ID=6
ALEGRA_PAYMENT_FORM=CASH
ALEGRA_STAMP_DIAN=false

# Factus
FACTUS_EMAIL=
FACTUS_PASSWORD=
FACTUS_PREFIJO=SETP
FACTUS_CUSTOMER_EMAIL=
FACTUS_CITY_CODE=11001
FACTUS_PAYMENT_FORM=1
FACTUS_PAYMENT_METHOD=10

# Alanube
ALANUBE_USERNAME=
ALANUBE_PASSWORD=
ALANUBE_PREFIJO=SETP
ALANUBE_CUSTOMER_TYPE_ID=
ALANUBE_CUSTOMER_EMAIL=
ALANUBE_CUSTOMER_CITY=
ALANUBE_PAYMENT_FORM=1
ALANUBE_PAYMENT_METHOD=10

# OpenData
OPENDATA_API_KEY=
OPENDATA_SECRET_KEY=
OPENDATA_PREFIJO=SETP
OPENDATA_CLIENTE_TIPO_ID=
OPENDATA_CLIENTE_EMAIL=
OPENDATA_CLIENTE_CIUDAD=
OPENDATA_FORMA_PAGO=
OPENDATA_METODO_PAGO=

# DIAN Gratuito
DIAN_NIT=
DIAN_PASSWORD=
DIAN_CODIGO_SOFTWARE=
DIAN_PIN_SOFTWARE=
DIAN_CERT_PATH=
DIAN_CERT_PASS=
DIAN_AMBIENTE=habilitacion
DIAN_PREFIJO=SETP
DIAN_CLIENTE_TIPO_ID=
DIAN_CLIENTE_EMAIL=
DIAN_CLIENTE_MUNICIPIO=
DIAN_CLIENTE_DEPARTAMENTO=
DIAN_EMPRESA_CIUDAD=
DIAN_EMPRESA_DEPTO=

# Webhook
WEBHOOK_URL=
WEBHOOK_TOKEN=
WEBHOOK_HEADER=
WEBHOOK_VALOR=
WEBHOOK_TIMEOUT=8000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# FACTURACIÓN ELECTRÓNICA DIAN
# ============================================================
FACTURACION_PROVEEDOR=factus
FACTURACION_EMISION_AUTO=false
FACTURACION_ESTADO_DISPARA=pagado
FACTURACION_ENVIAR_MAIL=true

# ============================================================
# ALERTAS TELEGRAM
# ============================================================
ALERTAS_TELEGRAM_TOKEN=
ALERTAS_TELEGRAM_CHAT_ID=

# ============================================================
# PANEL PASSWORD
# ============================================================
# Generate with: openssl rand -hex 16
PANEL_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_16

# ============================================================
# SEGMENTO Y CONFIGURACIÓN NEGOCIO
# ============================================================
NEGOCIO=Mi Comercio
SEGMENTO=comidas
CIIU=5611
MONEDA=COP
HORA_REPORTE=21:00
NUMERO_DUENO=573001234567
UBICACION_NEGOCIO_LAT=6.217
UBICACION_NEGOCIO_LNG=-75.567

# Domicilios
DOMICILIOS_RADIO_MAX_ENTREGA_KM=25
DOMICILIOS_GRATIS_SI_TOTAL_SOBRE=80000

# ============================================================
# PLANES IA
# ============================================================
PLAN_BASICO_LIMITE_DIARIO=100
PLAN_BASICO_LIMITE_MENSUAL=2000
PLAN_BASICO_PRECIO_MENSUAL=50000

PLAN_PRO_LIMITE_DIARIO=500
PLAN_PRO_LIMITE_MENSUAL=10000
PLAN_PRO_PRECIO_MENSUAL=150000

PLAN_EMPRESA_LIMITE_DIARIO=2000
PLAN_EMPRESA_LIMITE_MENSUAL=50000
PLAN_EMPRESA_PRECIO_MENSUAL=500000

# ============================================================
# ALERTAS TELEGRAM
# ============================================================
ALERTAS_TELEGRAM_TOKEN=
ALERTAS_TELEGRAM_CHAT_ID=

# ============================================================
# SEGURIDAD
# ============================================================
SECURITY_RATE_LIMIT_WINDOW_MS=60000
SECURITY_RATE_LIMIT_MAX_REQUESTS=100
SECURITY_CSRF_ENABLED=true
SECURITY_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SECURITY_HELMET_ENABLED=true

# ============================================================
# OBSERVABILITY
# ============================================================
OBSERVABILITY_METRICS_PORT=9090
OBSERVABILITY_TRACING_ENABLED=true
OBSERVABILITY_LOG_LEVEL=info
OBSERVABILITY_LOG_FORMAT=json

# ============================================================
# FEATURE FLAGS
# ============================================================
FEATURE_WHATSAPP=true
FEATURE_ORDERS=true
FEATURE_INVENTORY=true
FEATURE_ACCOUNTING=true
FEATURE_CRM=false
FEATURE_HR=false
FEATURE_BI=false
FEATURE_AI=true

# ============================================================
# PAYMENT PROVIDERS
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
WOOMPI_PUBLIC_KEY=
WOOMPI_PRIVATE_KEY=
WOOMPI_INTEGRITY_SECRET=
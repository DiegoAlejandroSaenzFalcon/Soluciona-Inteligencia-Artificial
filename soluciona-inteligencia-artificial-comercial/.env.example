# ============================================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL)
# ============================================================
# Motor operacional: 'sqlite' (por defecto) | 'postgres'
DB_ENGINE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soluciona_inteligencia_artificial_comercial
DB_USER=postgres
DB_PASS=postgres
DB_POOL_SIZE=10
DB_DEBUG=false

# ============================================================
# CONFIGURACIÓN DEL BOT WHATSAPP
# ============================================================
# Puerto del servidor web (dashboard)
PORT=3000

# Número del dueño (formato: 573000000000)
OWNER_NUMBER=573000000000

# ============================================================
# LLM / IA (NVIDIA / OpenRouter / OpenAI compatible)
# ============================================================
LLM_PROVEEDOR=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-8b-instruct
LLM_API_KEY=tu_api_key_aqui
LLM_LIMITE_DIARIO=1000
LLM_LIMITE_MENSUAL=10000

# Asistentes IA (panel)
ASISTENTES_IA_MODEL=meta/llama-3.3-70b-instruct
ASISTENTES_IA_API_KEY=tu_api_key_aqui
ASISTENTES_IA_LIMITE_DIARIO=500
ASISTENTES_IA_LIMITE_MENSUAL=5000

# Visión (foto menú)
VISION_MODEL=meta/llama-3.2-11b-vision-instruct
VISION_API_KEY=tu_api_key_aqui

# Gemini (fallback)
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash

# ============================================================
# TELEGRAM (alertas bot caído)
# ============================================================
ALERTAS_TELEGRAM_TOKEN=tu_bot_token
ALERTAS_TELEGRAM_CHAT_ID=tu_chat_id

# ============================================================
# SEGURIDAD
# ============================================================
# Contraseña del panel web (opcional)
PANEL_PASSWORD=

# JWT Secret para auth (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=tu_jwt_secret_aqui

# ============================================================
# DIAN / FACTURACIÓN (opcional)
# ============================================================
DIAN_NIT=
DIAN_DV=
DIAN_CODIGO_SOFTWARE=
DIAN_PIN_SOFTWARE=
DIAN_CERT_PATH=
DIAN_CERT_PASS=
DIAN_AMBIENTE=habilitacion

# ============================================================
# INTEGRACIONES POS (opcional)
# ============================================================
INTEGRACION_TIPO=pos-propio
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=
SIIGO_DOCUMENT_ID=
SIIGO_PAYMENT_ID=
SIIGO_TAX_ID=
SIIGO_CUSTOMER_IDENTIFICATION=

# ============================================================
# OTROS
# ============================================================
NODE_ENV=development
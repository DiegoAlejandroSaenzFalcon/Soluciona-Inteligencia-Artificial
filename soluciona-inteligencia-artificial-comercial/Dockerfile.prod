# Dockerfile for Production - Multi-stage build
# Stage 1: Builder
FROM node:22-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    git \
    python3 \
    make \
    g++ \
    sqlite \
    postgresql-client

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev for build)
RUN npm ci

# Copy source code
COPY . .

# Build TypeScript
RUN npm run build

# Remove dev dependencies
RUN npm prune --production

# Stage 2: Runtime
FROM node:22-alpine AS runtime

# Install runtime dependencies
RUN apk add --no-cache \
    sqlite \
    postgresql-client \
    curl \
    dumb-init \
    tini

# Create non-root user
RUN addgroup -g 1000 -S nodejs && \
    adduser -S nodejs -u 1000 -G nodejs

WORKDIR /app

# Copy built application from builder
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/package*.json ./
COPY --from=builder --chown=nodejs:nodejs /app/config*.json ./
COPY --from=builder --chown=nodejs:nodejs /app/panel-*.html ./
COPY --from=builder --chown=nodejs:nodejs /app/panel-*.js ./
COPY --from=builder --chown=nodejs:nodejs /app/dashboard.html ./
COPY --from=builder --chown=nodejs:nodejs /app/kds.html ./
COPY --from=builder --chown=nodejs:nodejs /app/sw.js ./
COPY --from=builder --chown=nodejs:nodejs /app/manifest.webmanifest ./
COPY --from=builder --chown=nodejs:nodejs /app/public ./public

# Create directories
RUN mkdir -p /app/data /app/logs /app/uploads && \
    chown -R nodejs:nodejs /app/data /app/logs /app/uploads

# Switch to non-root user
USER nodejs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || exit 1

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]

# Start application
CMD ["node", "--experimental-sqlite", "dist/index.js"]